--- a/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c
+++ b/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c
@@ -50,11 +50,32 @@
 			WARN_ON(reset_control_deassert(kbdev->resets[i]));
 	};
 
-	for (i = 0; i < kbdev->nr_clocks; i++) {
-		if (WARN_ON(kbdev->clocks[i] == NULL))
-			;
-		else if (!__clk_is_enabled(kbdev->clocks[i]))
-			WARN_ON(clk_enable(kbdev->clocks[i]));
+	/* When the GPU is also behind a genpd power domain (devicetree has
+	 * both "clocks" and "power-domains" pointing at the same provider,
+	 * e.g. Renesas rzv2h's CPG), genpd_runtime_resume()/_suspend() call
+	 * genpd_start_dev()/genpd_stop_dev() (their own pm_clk-based clock
+	 * enable/disable, using genpd's own clk references) before/after
+	 * calling this driver's own runtime callback via
+	 * pm_generic_runtime_resume()/_suspend(). Enabling here is
+	 * consequently always a no-op (the clock is already on by the time
+	 * we get here), but disabling here is not always a no-op: whether
+	 * __clk_is_enabled() is still true depends on how many resumes
+	 * already happened, so this can end up decrementing enable_count
+	 * to 0 here, and genpd's own disable right after us then hits
+	 * clk_core_disable()'s WARN_ON(enable_count == 0). Simplest correct
+	 * fix: leave these clocks alone entirely when genpd owns them, and
+	 * let genpd be the sole caller of clk_enable()/clk_disable() on
+	 * them for the rest of the device's life (the one-time
+	 * clk_prepare_enable() done at probe in mali_kbase_core_linux.c is
+	 * left as-is and untouched by this guard).
+	 */
+	if (!kbdev->dev->pm_domain) {
+		for (i = 0; i < kbdev->nr_clocks; i++) {
+			if (WARN_ON(kbdev->clocks[i] == NULL))
+				;
+			else if (!__clk_is_enabled(kbdev->clocks[i]))
+				WARN_ON(clk_enable(kbdev->clocks[i]));
+		}
 	}
 }
 
@@ -62,12 +83,17 @@
 {
 	unsigned int i;
 
-	for (i = 0; i < kbdev->nr_clocks; i++) {
-		if (WARN_ON(kbdev->clocks[i] == NULL))
-			;
-		else if (__clk_is_enabled(kbdev->clocks[i])) {
-			clk_disable(kbdev->clocks[i]);
-			WARN_ON(__clk_is_enabled(kbdev->clocks[i]));
+	/* See the matching comment in enable_gpu_power_control(): when
+	 * genpd also owns these clocks, leave them entirely to genpd.
+	 */
+	if (!kbdev->dev->pm_domain) {
+		for (i = 0; i < kbdev->nr_clocks; i++) {
+			if (WARN_ON(kbdev->clocks[i] == NULL))
+				;
+			else if (__clk_is_enabled(kbdev->clocks[i])) {
+				clk_disable(kbdev->clocks[i]);
+				WARN_ON(__clk_is_enabled(kbdev->clocks[i]));
+			}
 		}
 	}
 
