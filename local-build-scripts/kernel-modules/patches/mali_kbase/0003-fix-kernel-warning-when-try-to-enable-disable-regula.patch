From bcecc588b943f46a774a2ffd36bc96f6e7991664 Mon Sep 17 00:00:00 2001
From: Nhat Thieu <nhat.thieu.xr@renesas.com>
Date: Wed, 20 Aug 2025 14:02:59 +0700
Subject: [PATCH] Fix kernel warning when try to enable/disable regulator

Signed-off-by: Nhat Thieu <nhat.thieu.xr@renesas.com>

Upstream-Status: Pending

---
 drivers/gpu/arm/midgard/mali_kbase_core_linux.c           | 8 ++++----
 drivers/gpu/arm/midgard/mali_kbase_defs.h                 | 3 ++-
 .../midgard/platform/devicetree/mali_kbase_runtime_pm.c   | 4 ++--
 3 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/drivers/gpu/arm/midgard/mali_kbase_core_linux.c b/drivers/gpu/arm/midgard/mali_kbase_core_linux.c
index 13ed7e3..3e27069 100644
--- a/drivers/gpu/arm/midgard/mali_kbase_core_linux.c
+++ b/drivers/gpu/arm/midgard/mali_kbase_core_linux.c
@@ -4603,7 +4603,7 @@ int power_control_init(struct kbase_device *kbdev)
 	/* Regulator array must be terminated with a NULL pointer, because of how the
 	 * Linux kernel iterates through them.
 	 */
-	static const char *const regulator_names[] = { "mali", "shadercores", NULL };
+	static const char *const regulator_names[] = { "mali", NULL };
 	static const char *avail_regulator_names[BASE_MAX_NR_CLOCKS_REGULATORS + 1];
 	/* Usually, clocks and regulators go in pairs.
 	 * The reduction of 1 is to account for the NULL pointer that ends the list.
@@ -4625,7 +4625,7 @@ int power_control_init(struct kbase_device *kbdev)
 	 * operating with a partial initialization of regulators.
 	 */
 	k = 0;
-	for (i = 0; i < BASE_MAX_NR_CLOCKS_REGULATORS; i++) {
+	for (i = 0; i < ARRAY_SIZE(regulator_names); i++) {
 		const char *id = (i < ARRAY_SIZE(regulator_names)) ? regulator_names[i] : NULL;
 
 		kbdev->regulators[k] = regulator_get_optional(kbdev->dev, id);
@@ -4640,7 +4640,7 @@ int power_control_init(struct kbase_device *kbdev)
 		}
 	}
 	if (err == -EPROBE_DEFER) {
-		while (k > 0)
+		while ((k > 0) && (k < ARRAY_SIZE(regulator_names)))
 			regulator_put(kbdev->regulators[--k]);
 		return err;
 	}
@@ -4726,7 +4726,7 @@ int power_control_init(struct kbase_device *kbdev)
 #elif (KERNEL_VERSION(4, 10, 0) <= LINUX_VERSION_CODE)
 	if (kbdev->nr_regulators > 0) {
 		kbdev->opp_table = dev_pm_opp_set_regulators(kbdev->dev, avail_regulator_names,
-							     BASE_MAX_NR_CLOCKS_REGULATORS);
+							     kbdev->nr_regulators);
 
 		if (IS_ERR(kbdev->opp_table)) {
 			err = PTR_ERR(kbdev->opp_table);
diff --git a/drivers/gpu/arm/midgard/mali_kbase_defs.h b/drivers/gpu/arm/midgard/mali_kbase_defs.h
index 90dde6c..8377383 100644
--- a/drivers/gpu/arm/midgard/mali_kbase_defs.h
+++ b/drivers/gpu/arm/midgard/mali_kbase_defs.h
@@ -141,7 +141,8 @@
  * This is dependent on support for of_property_read_u64_array() in the
  * kernel.
  */
-#define BASE_MAX_NR_CLOCKS_REGULATORS (2)
+#define BASE_MAX_NR_CLOCKS_REGULATORS (3)
+#define IS_REGULATOR_ALWAYS_ON (1)
 
 /* Forward declarations */
 struct kbase_context;
diff --git a/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c b/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c
index 5b2beac..7ac330a 100644
--- a/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c
+++ b/drivers/gpu/arm/midgard/platform/devicetree/mali_kbase_runtime_pm.c
@@ -34,7 +34,7 @@ static void enable_gpu_power_control(struct kbase_device *kbdev)
 {
 	unsigned int i;
 
-#if defined(CONFIG_REGULATOR)
+#if (defined(CONFIG_REGULATOR) && (!IS_REGULATOR_ALWAYS_ON))
 	for (i = 0; i < kbdev->nr_regulators; i++) {
 		if (WARN_ON(kbdev->regulators[i] == NULL))
 			;
@@ -78,7 +78,7 @@ static void disable_gpu_power_control(struct kbase_device *kbdev)
 			WARN_ON(reset_control_assert(kbdev->resets[i]));
 	};
 
-#if defined(CONFIG_REGULATOR)
+#if (defined(CONFIG_REGULATOR) && (!IS_REGULATOR_ALWAYS_ON))
 	for (i = 0; i < kbdev->nr_regulators; i++) {
 		if (WARN_ON(kbdev->regulators[i] == NULL))
 			;
-- 
2.25.1

