# PREEMPT_RT variant fragment for the RZ/V2H RDK.
#
# Merged by build_kernel.sh on top of rzv2h_defconfig when
# KERNEL_VARIANT=preempt-rt. It is concatenated *after* the
# CONFIG_LOCALVERSION lines mk_config_merged writes from the board
# defconfig, so the CONFIG_LOCALVERSION below is the one that wins ("last
# assignment wins" under KCONFIG_ALLCONFIG) and the kernel release becomes
# <version>-arm64-renesas-rt instead of the stock <version>-arm64-renesas.
# That distinct release string is what keeps the two kernels'
# /usr/lib/modules/<release> trees from colliding.
#
# Keep the suffix free of underscores: it becomes the Debian package name
# and version, and dpkg rejects "_" in a version field.
#
# Verified by a real boot on RZ/V2H RDK hardware (2026-09-23): uname -r ==
# 6.18.20-arm64-renesas-rt, /sys/kernel/realtime == 1.

# PREEMPT_RT kernel overrides
CONFIG_EXPERT=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_RT=y
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPTION=y
CONFIG_PROVE_LOCKING=n
CONFIG_ARCH_SUPPORTS_RT=y
CONFIG_LOCALVERSION="-arm64-renesas-rt"
CONFIG_LOCALVERSION_AUTO=n

# Disable conflicting preemption modes
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_DYNAMIC is not set
# CONFIG_PREEMPT_LAZY is not set

# RT_GROUP_SCHED adds cgroup-based RT-bandwidth throttling overhead on top of
# the scheduler, which fights the whole point of this variant. With it on,
# /proc/sys/kernel/sched_rt_runtime_us defaults to a throttled 950000 instead
# of unrestricted -1 (confirmed by a real boot: this line was missing at
# first and the board came up throttled).
# CONFIG_RT_GROUP_SCHED is not set

CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_REDUCED=y
# CONFIG_SCHED_DEBUG is not set

# Disable debug overhead that adds latency
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_DEBUG_RT_MUTEXES is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_WW_MUTEX_SLOWPATH is not set
# CONFIG_LOCKDEP is not set

# ---------------------------------------------------------------------------
# Pin back what CONFIG_EXPERT unhides
# ---------------------------------------------------------------------------
# PREEMPT_RT depends on EXPERT, and a number of unrelated symbols are
# declared "default y if !EXPERT". Turning EXPERT on therefore silently
# changes them, which has nothing to do with preemption. Confirmed by a real
# build+boot (2026-09-23) that rzv2h_defconfig hits the exact same symbols
# already documented for the R-Car V4H Sparrow Hawk board (rcar-utils commit
# af04c7c0):
#
#   MEDIA_SUPPORT_FILTER  y -> n, unhiding the whole media/DVB menu and
#                         adding ~150 frontend/tuner modules to the build
#                         (the RT build before this line took noticeably
#                         longer and produced them all, unused)
#   INPUT_FF_MEMLESS      y -> n
#   HID_*                 y -> n, dropping the USB keyboard/mouse quirk
#                         drivers the board actually uses
#
# Restore the values the stock rzv2h_defconfig build produces without
# EXPERT, so the only difference between this kernel and the stock one is
# the preemption model. Verified against the Kconfig source directly:
# MEDIA_SUPPORT_FILTER and HID_* declare "default y if !EXPERT" /
# "default !EXPERT"; INPUT_FF_MEMLESS has no such clause itself but is
# select'd by several HID_* force-feedback drivers, so it is pinned back
# explicitly here too rather than relying on which HID driver would pull it
# back in transitively.
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_HID_A4TECH=y
CONFIG_HID_APPLE=y
CONFIG_HID_BELKIN=y
CONFIG_HID_CHERRY=y
CONFIG_HID_CHICONY=y
CONFIG_HID_CYPRESS=y
CONFIG_HID_EZKEY=y
CONFIG_HID_ITE=y
CONFIG_HID_KENSINGTON=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_MONTEREY=y
CONFIG_HID_REDRAGON=y
