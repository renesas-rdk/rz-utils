 	/* I2C7	*/
 	*(volatile u32 *)CPG_CLKON_9 = 0x08000800;
 	*(volatile u32 *)CPG_RST_9   = 0x80008000;
+#endif
+#if CONFIG_TARGET_RZV2H_RDK
+	/* I2C3	*/
+	*(volatile u32 *)PFC_23  = (*(volatile u32 *)PFC_23 & 0x00FFFFFF) | (0x01 << 28) | (0x01 << 24);
+	*(volatile u8 *)PMC_23   |= (0x03) << 6;	/* P37,P36 multiplexed function	*/
+
+	*(volatile u32 *)CPG_CLKON_9 = 0x00800080;
+	*(volatile u32 *)CPG_RST_9   = 0x08000800;
+
+	/* PHY_RESET	*/
+	*(volatile u8 *)PMC_24   &= ~(0x01 << 7);	/* P47 port	*/
 #endif
 	/* I2C8 */
 	*(volatile u32 *)PFC_20  = (*(volatile u32 *)PFC_20 & 0x00FFFFFF) | (0x01 << 28) | (0x01 << 24);
@@ -383,6 +396,24 @@ pmic_failed:
 }
 
 
+#if CONFIG_TARGET_RZV2H_RDK
+int board_late_init(void)
+{
+	/*
+	 * RESET_N of Ethernet PHY (KSZ9131) is driven by P47 through a diode,
+	 * with 10K/10uF RC pull-up to DVDDH. Drive P47 low to assert reset,
+	 * then drive it high and wait for RESET_N to rise via the RC.
+	 */
+	*(volatile u8 *)P_24    &= ~(0x01 << 7);	/* P47=0	*/
+	*(volatile u16 *)PM_24   = (*(volatile u16 *)PM_24 & ~(0x03 << 14)) | (0x02 << 14); /* P47 output	*/
+	mdelay(20);
+
+	*(volatile u8 *)P_24    |= (0x01 << 7);	/* P47=1	*/
+	mdelay(200);
+
+	return 0;
+}
+#else
 int board_late_init(void)
 {
 	struct udevice *dev;
@@ -407,6 +438,7 @@ int board_late_init(void)
 
 	return ret;
 }
+#endif /* CONFIG_TARGET_RZV2H_RDK */
 
 int board_early_init_f(void)
 {
@@ -422,7 +454,7 @@ int board_init(void)
 	board_usb_init();
 
