+		"ext4load mmc ${mmcdev}:${mmcpart} ${codaddr} boot/${codbin}; " \
+		"ext4load mmc ${mmcdev}:${mmcpart} ${image_addr} boot/Image; " \
+		"ext4load mmc ${mmcdev}:${mmcpart} ${dtb_addr} boot/${dtbfile}\0" \
+	"prodsdboot=run prodsdload; run prodsdbootargs; run bootimage\0" \
+	"bootimage=booti ${image_addr} - ${dtb_addr}\0"
